  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LigaArmenia.Application\LigaArmenia.Application.csproj" />
    <ProjectReference Include="..\LigaArmenia.Infrastructure\LigaArmenia.Infrastructure.csproj" />
  </ItemGroup>

