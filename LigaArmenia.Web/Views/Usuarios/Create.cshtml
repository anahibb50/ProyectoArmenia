@model LigaArmenia.Web.ViewModels.Users.UsuarioCreateViewModel
@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="la-page-header">
    <div>
        <span class="la-page-eyebrow">Usuarios · Registro</span>
        <h1 class="la-page-title">Registrar Nuevo Usuario</h1>
        <p class="la-page-description">
            Crea una cuenta interna y asigna los roles correspondientes según sus funciones en la liga.
        </p>
    </div>
    <a asp-action="Index" class="la-btn la-btn-secondary">Volver al listado</a>
</div>

<div class="la-card" style="max-width: 820px;">
    <form asp-action="Create" method="post" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" role="alert"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Nombres" class="la-form-label"></label>
                <input asp-for="Nombres" class="la-form-control" placeholder="Ej. María Fernanda Torres" />
                <span asp-validation-for="Nombres" class="la-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Correo" class="la-form-label"></label>
                <input asp-for="Correo" class="la-form-control" type="email" placeholder="usuario@ligalaarmenia.org" />
                <span asp-validation-for="Correo" class="la-validation-error"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Password" class="la-form-label"></label>
                <div class="la-input-group">
                    <input asp-for="Password" id="createPassword" class="la-form-control" type="password" autocomplete="new-password" />
                    <button type="button" class="la-password-toggle" data-toggle-password="createPassword" aria-label="Mostrar u ocultar contraseña">
                        <svg data-eye-open width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg data-eye-closed class="d-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>
                <div class="la-form-hint">Mínimo 8 caracteres, mayúscula, minúscula, número y carácter especial.</div>
                <span asp-validation-for="Password" class="la-validation-error"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="la-form-label"></label>
                <div class="la-input-group">
                    <input asp-for="ConfirmPassword" id="createConfirmPassword" class="la-form-control" type="password" autocomplete="new-password" />
                    <button type="button" class="la-password-toggle" data-toggle-password="createConfirmPassword" aria-label="Mostrar u ocultar contraseña">
                        <svg data-eye-open width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg data-eye-closed class="d-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="la-validation-error"></span>
            </div>
        </div>

        <hr class="my-4" style="border-color: var(--la-border-subtle);" />

        <div class="mb-3">
            <label class="la-form-label">Roles asignados</label>
            <div class="row g-2">
                @foreach (var rol in Model.RolesDisponibles)
                {
                    var isChecked = Model.RoleIds.Contains(rol.Id);
                    <div class="col-md-6">
                        <label class="la-check-card h-100">
                            <input type="checkbox"
                                   name="RoleIds"
                                   value="@rol.Id"
                                   data-role-name="@rol.Nombre"
                                   checked="@isChecked" />
                            <span>
                                <strong class="d-block" style="font-size: 0.88rem;">@rol.Nombre.Replace("_", " ")</strong>
                                @if (!string.IsNullOrWhiteSpace(rol.Descripcion))
                                {
                                    <span style="font-size: 0.78rem; color: var(--la-text-secondary);">@rol.Descripcion</span>
                                }
                            </span>
                        </label>
                    </div>
                }
            </div>
        </div>

        <div class="la-perm-module mb-4 d-none" data-vocal-section>
            <div class="la-perm-module-header mb-3">
                <div>
                    <h2 class="la-card-title" style="font-size: 0.96rem;">Información del vocal</h2>
                    <div style="font-size: 0.8rem; color: var(--la-text-secondary);">
                        Al asignar el rol VOCAL se creará automáticamente su perfil en el módulo de Vocales utilizando los nombres ingresados arriba.
                    </div>
                </div>
                <span class="la-badge la-badge-success">Perfil automático</span>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="TelefonoVocal" class="la-form-label"></label>
                    <input asp-for="TelefonoVocal"
                           class="la-form-control"
                           type="tel"
                           maxlength="35"
                           placeholder="Ej. 0991234567" />
                    <div class="la-form-hint">Opcional. Máximo 35 caracteres.</div>
                    <span asp-validation-for="TelefonoVocal" class="la-validation-error"></span>
                </div>
            </div>
        </div>

        <div class="mb-4">
            <label class="d-inline-flex align-items-center gap-2" style="cursor: pointer;">
                <input asp-for="Activo" style="accent-color: var(--la-accent-primary);" />
                <span>Cuenta habilitada inmediatamente</span>
            </label>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="la-btn la-btn-primary">Registrar usuario</button>
            <a asp-action="Index" class="la-btn la-btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
