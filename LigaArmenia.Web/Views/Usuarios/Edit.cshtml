@model LigaArmenia.Web.ViewModels.Users.UsuarioEditViewModel
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="la-page-header">
    <div>
        <span class="la-page-eyebrow">Usuarios · Edición</span>
        <h1 class="la-page-title">Editar Usuario</h1>
        <p class="la-page-description">
            Actualiza la información básica y los roles asignados. Los cambios se aplicarán de inmediato a las sesiones vigentes.
        </p>
    </div>
    <a asp-action="Index" class="la-btn la-btn-secondary">Volver al listado</a>
</div>

<div class="la-card" style="max-width: 820px;">
    <form asp-action="Edit" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Activo" />
        <input type="hidden" asp-for="TienePerfilVocal" />
        <input type="hidden" asp-for="VocalActivo" />

        <div asp-validation-summary="ModelOnly" role="alert"></div>

        <div class="d-flex align-items-center justify-content-between mb-3 pb-3" style="border-bottom: 1px solid var(--la-border-subtle);">
            <div>
                <span style="font-size: 0.82rem; color: var(--la-text-secondary);">Estado actual:</span>
                @if (Model.Activo)
                {
                    <span class="la-badge la-badge-success ms-2">
                        <span class="la-status-dot la-status-dot-active"></span> Activo
                    </span>
                }
                else
                {
                    <span class="la-badge la-badge-danger ms-2">
                        <span class="la-status-dot la-status-dot-inactive"></span> Inactivo
                    </span>
                }
            </div>
            <a asp-action="ResetPassword" asp-route-id="@Model.Id" class="la-btn la-btn-warning la-btn-sm">
                Restablecer contraseña
            </a>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Nombres" class="la-form-label"></label>
                <input asp-for="Nombres" class="la-form-control" />
                <span asp-validation-for="Nombres" class="la-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Correo" class="la-form-label"></label>
                <input asp-for="Correo" class="la-form-control" type="email" />
                <span asp-validation-for="Correo" class="la-validation-error"></span>
            </div>
        </div>

        <hr class="my-4" style="border-color: var(--la-border-subtle);" />

        <div class="mb-4">
            <label class="la-form-label">Roles asignados</label>
            <div class="row g-2">
                @foreach (var rol in Model.RolesDisponibles)
                {
                    var isChecked = Model.RoleIds.Contains(rol.Id);
                    <div class="col-md-6">
                        <label class="la-check-card h-100">
                            <input type="checkbox"
                                   name="RoleIds"
                                   value="@rol.Id"
                                   data-role-name="@rol.Nombre"
                                   checked="@isChecked" />
                            <span>
                                <strong class="d-block" style="font-size: 0.88rem;">@rol.Nombre.Replace("_", " ")</strong>
                                @if (!string.IsNullOrWhiteSpace(rol.Descripcion))
                                {
                                    <span style="font-size: 0.78rem; color: var(--la-text-secondary);">@rol.Descripcion</span>
                                }
                            </span>
                        </label>
                    </div>
                }
            </div>
        </div>

        <div class="la-perm-module mb-4 d-none" data-vocal-section>
            <div class="la-perm-module-header mb-3">
                <div>
                    <h2 class="la-card-title" style="font-size: 0.96rem;">Información del vocal</h2>
                    <div style="font-size: 0.8rem; color: var(--la-text-secondary);">
                        @if (Model.TienePerfilVocal)
                        {
                            <span>Este usuario ya cuenta con un perfil de vocal (@(Model.VocalActivo ? "activo" : "inactivo")). Los cambios en nombres o teléfono se sincronizarán automáticamente.</span>
                        }
                        else
                        {
                            <span>Al asignar el rol VOCAL se creará automáticamente su perfil de vocal utilizando los nombres del usuario.</span>
                        }
                    </div>
                </div>
                <span class="la-badge @(Model.TienePerfilVocal ? (Model.VocalActivo ? "la-badge-success" : "la-badge-warning") : "la-badge-success")">
                    @(Model.TienePerfilVocal ? (Model.VocalActivo ? "Vocal activo" : "Vocal inactivo") : "Nuevo perfil")
                </span>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="TelefonoVocal" class="la-form-label"></label>
                    <input asp-for="TelefonoVocal"
                           class="la-form-control"
                           type="tel"
                           maxlength="35"
                           placeholder="Ej. 0991234567" />
                    <div class="la-form-hint">Opcional. Máximo 35 caracteres.</div>
                    <span asp-validation-for="TelefonoVocal" class="la-validation-error"></span>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="la-btn la-btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="la-btn la-btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
