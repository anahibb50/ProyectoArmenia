@model LigaArmenia.Web.ViewModels.Users.UsuarioIndexViewModel
@inject ICurrentUserService CurrentUser
@inject IUserSecurityStateService SecurityStateService
@{
    ViewData["Title"] = "Gestión de Usuarios";
    UserSecurityState? state = CurrentUser.UserId.HasValue
        ? await SecurityStateService.GetStateAsync(CurrentUser.UserId.Value)
        : null;

    bool canCreate = state?.HasPermission(SystemPermissions.UsuariosCrear) == true;
    bool canEdit = state?.HasPermission(SystemPermissions.UsuariosEditar) == true;
    bool canToggle = state?.HasPermission(SystemPermissions.UsuariosDesactivar) == true;
}

<div class="la-page-header">
    <div>
        <span class="la-page-eyebrow">Seguridad · Cuentas</span>
        <h1 class="la-page-title">Gestión de Usuarios</h1>
        <p class="la-page-description">
            Administra las cuentas del sistema, sus roles asignados y su estado de acceso.
        </p>
    </div>
    @if (canCreate)
    {
        <a asp-action="Create" class="la-btn la-btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Nuevo usuario</span>
        </a>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="la-stat-card">
            <div class="la-stat-label">Total mostrados</div>
            <div class="la-stat-value">@Model.Usuarios.Count</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="la-stat-card">
            <div class="la-stat-label">Cuentas activas</div>
            <div class="la-stat-value" style="color: var(--la-accent-primary);">@Model.TotalActivos</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="la-stat-card">
            <div class="la-stat-label">Cuentas inactivas</div>
            <div class="la-stat-value" style="color: #FCA5A5;">@Model.TotalInactivos</div>
        </div>
    </div>
</div>

<div class="la-card mb-4">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label for="busqueda" class="la-form-label">Buscar por nombre o correo</label>
            <input id="busqueda"
                   name="busqueda"
                   value="@Model.Busqueda"
                   class="la-form-control"
                   placeholder="Ej. Carlos Pérez o correo@dominio.com" />
        </div>
        <div class="col-md-3">
            <label for="rolId" class="la-form-label">Rol</label>
            <select id="rolId" name="rolId" class="la-form-select">
                <option value="">Todos los roles</option>
                @foreach (var rol in Model.RolesDisponibles)
                {
                    <option value="@rol.Id" selected="@(Model.RolId == rol.Id)">@rol.Nombre.Replace("_", " ")</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label for="activo" class="la-form-label">Estado</label>
            <select id="activo" name="activo" class="la-form-select">
                <option value="">Todos</option>
                <option value="true" selected="@(Model.Activo == true)">Activos</option>
                <option value="false" selected="@(Model.Activo == false)">Inactivos</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="la-btn la-btn-primary w-100">Filtrar</button>
            @if (!string.IsNullOrWhiteSpace(Model.Busqueda) || Model.RolId.HasValue || Model.Activo.HasValue)
            {
                <a asp-action="Index" class="la-btn la-btn-secondary" title="Limpiar filtros">Limpiar</a>
            }
        </div>
    </form>
</div>

@if (Model.Usuarios.Count == 0)
{
    <div class="la-empty-state">
        <div class="la-empty-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="17" y1="8" x2="23" y2="14"/><line x1="23" y1="8" x2="17" y2="14"/></svg>
        </div>
        <h2 class="la-card-title mb-2">No se encontraron usuarios</h2>
        <p style="color: var(--la-text-secondary); font-size: 0.9rem;" class="mb-3">
            No hay cuentas que coincidan con los criterios de búsqueda actuales.
        </p>
        @if (canCreate)
        {
            <a asp-action="Create" class="la-btn la-btn-primary la-btn-sm">Registrar primer usuario</a>
        }
    </div>
}
else
{
    <div class="la-table-wrap">
        <table class="la-table">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Roles asignados</th>
                    <th>Estado</th>
                    <th>Actualizado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Usuarios)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@user.Nombres</div>
                            <div style="font-size: 0.82rem; color: var(--la-text-secondary);">@user.Correo</div>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var role in user.Roles)
                                {
                                    <span class="la-badge la-badge-neutral">@role.Replace("_", " ")</span>
                                }
                            </div>
                        </td>
                        <td>
                            @if (user.Activo)
                            {
                                <span class="la-badge la-badge-success">
                                    <span class="la-status-dot la-status-dot-active"></span>
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="la-badge la-badge-danger">
                                    <span class="la-status-dot la-status-dot-inactive"></span>
                                    Inactivo
                                </span>
                            }
                        </td>
                        <td style="font-size: 0.84rem; color: var(--la-text-secondary); white-space: nowrap;">
                            @user.ActualizadoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                @if (canEdit)
                                {
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="la-btn la-btn-secondary la-btn-sm">
                                        Editar
                                    </a>
                                    <a asp-action="ResetPassword" asp-route-id="@user.Id" class="la-btn la-btn-warning la-btn-sm">
                                        Clave
                                    </a>
                                }
                                @if (canToggle)
                                {
                                    <form asp-action="ToggleStatus"
                                          method="post"
                                          class="d-inline"
                                          data-confirm-title="@(user.Activo ? "Desactivar usuario" : "Activar usuario")"
                                          data-confirm-message="@(user.Activo ? $"¿Deseas desactivar la cuenta de {user.Nombres}? El usuario perderá acceso inmediato al sistema." : $"¿Deseas reactivar la cuenta de {user.Nombres}?")"
                                          data-confirm-button="@(user.Activo ? "Sí, desactivar" : "Sí, activar")"
                                          data-confirm-variant="@(user.Activo ? "danger" : "primary")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <input type="hidden" name="activo" value="@(!user.Activo)" />
                                        <button type="submit" class="la-btn @(user.Activo ? "la-btn-danger" : "la-btn-primary") la-btn-sm">
                                            @(user.Activo ? "Desactivar" : "Activar")
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
