@model LigaArmenia.Web.ViewModels.Users.UsuarioResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="la-page-header">
    <div>
        <span class="la-page-eyebrow">Usuarios · Credenciales</span>
        <h1 class="la-page-title">Restablecer Contraseña</h1>
        <p class="la-page-description">
            Define una nueva contraseña segura para <strong>@Model.Nombres</strong> (@Model.Correo).
        </p>
    </div>
    <a asp-action="Index" class="la-btn la-btn-secondary">Volver al listado</a>
</div>

<div class="la-card" style="max-width: 620px;">
    <form asp-action="ResetPassword"
          method="post"
          novalidate
          data-confirm-title="Confirmar restablecimiento"
          data-confirm-message="¿Confirmas el cambio de contraseña para @Model.Nombres? La contraseña anterior dejará de funcionar de inmediato."
          data-confirm-button="Sí, restablecer"
          data-confirm-variant="primary">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UsuarioId" />
        <input type="hidden" asp-for="Nombres" />
        <input type="hidden" asp-for="Correo" />

        <div asp-validation-summary="ModelOnly" role="alert"></div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="la-form-label"></label>
            <div class="la-input-group">
                <input asp-for="NewPassword" id="resetNewPassword" class="la-form-control" type="password" autocomplete="new-password" />
                <button type="button" class="la-password-toggle" data-toggle-password="resetNewPassword" aria-label="Mostrar u ocultar contraseña">
                    <svg data-eye-open width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg data-eye-closed class="d-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                </button>
            </div>
            <div class="la-form-hint">Debe incluir mínimo 8 caracteres, mayúscula, minúscula, número y carácter especial.</div>
            <span asp-validation-for="NewPassword" class="la-validation-error"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="la-form-label"></label>
            <div class="la-input-group">
                <input asp-for="ConfirmPassword" id="resetConfirmPassword" class="la-form-control" type="password" autocomplete="new-password" />
                <button type="button" class="la-password-toggle" data-toggle-password="resetConfirmPassword" aria-label="Mostrar u ocultar contraseña">
                    <svg data-eye-open width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg data-eye-closed class="d-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="la-validation-error"></span>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="la-btn la-btn-primary">Guardar nueva contraseña</button>
            <a asp-action="Index" class="la-btn la-btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
