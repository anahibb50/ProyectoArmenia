@model LigaArmenia.Web.ViewModels.Vocales.VocalIndexViewModel
@inject ICurrentUserService CurrentUser
@inject IUserSecurityStateService SecurityStateService
@{
    ViewData["Title"] = "Gestión de Vocales";
    UserSecurityState? state = CurrentUser.UserId.HasValue
        ? await SecurityStateService.GetStateAsync(CurrentUser.UserId.Value)
        : null;

    bool canCreateUser = state?.HasPermission(SystemPermissions.UsuariosCrear) == true;
    bool canEdit = state?.HasPermission(SystemPermissions.VocalesEditar) == true;
    bool canActivate = state?.HasPermission(SystemPermissions.VocalesActivar) == true;
    bool canDeactivate = state?.HasPermission(SystemPermissions.VocalesDesactivar) == true;
}

<div class="la-page-header">
    <div>
        <span class="la-page-eyebrow">Seguridad · Operación de Campo</span>
        <h1 class="la-page-title">Gestión de Vocales</h1>
        <p class="la-page-description">
            Administra los perfiles operativos de los vocales registrados, su disponibilidad para designaciones y sus datos de contacto.
        </p>
    </div>
    @if (canCreateUser)
    {
        <a asp-controller="Usuarios" asp-action="Create" asp-route-preselectVocal="true" class="la-btn la-btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Registrar vocal</span>
        </a>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="la-stat-card">
            <div class="la-stat-label">Total de vocales</div>
            <div class="la-stat-value">@Model.TotalRegistrados</div>
            <div class="la-stat-hint">Perfiles registrados en la liga</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="la-stat-card">
            <div class="la-stat-label">Vocales activos</div>
            <div class="la-stat-value" style="color: var(--la-accent-primary);">@Model.TotalActivos</div>
            <div class="la-stat-hint">Habilitados operativamente</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="la-stat-card">
            <div class="la-stat-label">Vocales inactivos</div>
            <div class="la-stat-value" style="color: #FCA5A5;">@Model.TotalInactivos</div>
            <div class="la-stat-hint">No elegibles para nuevas designaciones</div>
        </div>
    </div>
</div>

<div class="la-card mb-4">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-6">
            <label for="busqueda" class="la-form-label">Buscar por nombre, correo o teléfono</label>
            <input id="busqueda"
                   name="busqueda"
                   value="@Model.Busqueda"
                   class="la-form-control"
                   placeholder="Ej. Luis Paredes, vocal@dominio.com o 099..." />
        </div>
        <div class="col-md-3">
            <label for="activo" class="la-form-label">Estado operativo</label>
            <select id="activo" name="activo" class="la-form-select">
                <option value="">Todos</option>
                <option value="true" selected="@(Model.Activo == true)">Activos</option>
                <option value="false" selected="@(Model.Activo == false)">Inactivos</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="la-btn la-btn-primary w-100">Filtrar</button>
            @if (!string.IsNullOrWhiteSpace(Model.Busqueda) || Model.Activo.HasValue)
            {
                <a asp-action="Index" class="la-btn la-btn-secondary">Limpiar</a>
            }
        </div>
    </form>
</div>

@if (Model.Vocales.Count == 0)
{
    <div class="la-empty-state">
        <div class="la-empty-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h2 class="la-card-title mb-2">No se encontraron vocales</h2>
        <p style="color: var(--la-text-secondary); font-size: 0.9rem;" class="mb-3">
            No existen registros que coincidan con los filtros aplicados.
        </p>
        @if (canCreateUser)
        {
            <a asp-controller="Usuarios" asp-action="Create" asp-route-preselectVocal="true" class="la-btn la-btn-primary la-btn-sm">
                Registrar primer vocal
            </a>
        }
    </div>
}
else
{
    <div class="la-table-wrap mb-3">
        <table class="la-table">
            <thead>
                <tr>
                    <th>Vocal</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    <th>Fecha de registro</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vocal in Model.Vocales)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@vocal.Nombres</div>
                            <div style="font-size: 0.82rem; color: var(--la-text-secondary);">
                                @(string.IsNullOrWhiteSpace(vocal.Correo) ? "Sin cuenta de usuario asociada" : vocal.Correo)
                            </div>
                            @if (vocal.UsuarioId.HasValue && (!vocal.UsuarioActivo || !vocal.TieneRolVocal))
                            {
                                <div class="mt-1">
                                    @if (!vocal.UsuarioActivo)
                                    {
                                        <span class="la-badge la-badge-warning">Usuario inactivo</span>
                                    }
                                    @if (!vocal.TieneRolVocal)
                                    {
                                        <span class="la-badge la-badge-neutral">Sin rol VOCAL</span>
                                    }
                                </div>
                            }
                        </td>
                        <td style="color: var(--la-text-secondary); white-space: nowrap;">
                            @(string.IsNullOrWhiteSpace(vocal.Telefono) ? "No registrado" : vocal.Telefono)
                        </td>
                        <td>
                            @if (vocal.Activo)
                            {
                                <span class="la-badge la-badge-success">
                                    <span class="la-status-dot la-status-dot-active"></span>
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="la-badge la-badge-danger">
                                    <span class="la-status-dot la-status-dot-inactive"></span>
                                    Inactivo
                                </span>
                            }
                        </td>
                        <td style="font-size: 0.84rem; color: var(--la-text-secondary); white-space: nowrap;">
                            @vocal.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                @if (canEdit)
                                {
                                    <a asp-action="Edit" asp-route-id="@vocal.Id" class="la-btn la-btn-secondary la-btn-sm">
                                        Editar
                                    </a>
                                }
                                @if (vocal.Activo && canDeactivate)
                                {
                                    <form asp-action="Deactivate"
                                          method="post"
                                          class="d-inline"
                                          data-confirm-title="Desactivar perfil de vocal"
                                          data-confirm-message="¿Deseas desactivar a @vocal.Nombres como vocal? No podrá recibir nuevas designaciones ni gestionar nuevas vocalías, pero conservará su cuenta de usuario, otros roles y su historial."
                                          data-confirm-button="Sí, desactivar vocal"
                                          data-confirm-variant="danger">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@vocal.Id" />
                                        <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                                        <input type="hidden" name="activo" value="@Model.Activo" />
                                        <input type="hidden" name="page" value="@Model.Page" />
                                        <button type="submit" class="la-btn la-btn-danger la-btn-sm">
                                            Desactivar
                                        </button>
                                    </form>
                                }
                                else if (!vocal.Activo && canActivate)
                                {
                                    <form asp-action="Activate"
                                          method="post"
                                          class="d-inline"
                                          data-confirm-title="Activar perfil de vocal"
                                          data-confirm-message="¿Deseas reactivar el perfil operativo de @vocal.Nombres como vocal? Se verificará que su cuenta esté activa y conserve el rol VOCAL."
                                          data-confirm-button="Sí, activar vocal"
                                          data-confirm-variant="primary">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@vocal.Id" />
                                        <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                                        <input type="hidden" name="activo" value="@Model.Activo" />
                                        <input type="hidden" name="page" value="@Model.Page" />
                                        <button type="submit" class="la-btn la-btn-primary la-btn-sm">
                                            Activar
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div style="font-size: 0.84rem; color: var(--la-text-secondary);">
            Mostrando <strong>@Model.Vocales.Count</strong> de <strong>@Model.TotalFiltered</strong> resultado(s) · Página <strong>@Model.Page</strong> de <strong>@Model.TotalPages</strong>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Paginación de vocales" class="d-flex gap-1">
                <a asp-action="Index"
                   asp-route-busqueda="@Model.Busqueda"
                   asp-route-activo="@Model.Activo"
                   asp-route-page="@(Model.Page - 1)"
                   class="la-btn la-btn-secondary la-btn-sm @(Model.Page <= 1 ? "disabled" : "")">
                    Anterior
                </a>

                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <a asp-action="Index"
                       asp-route-busqueda="@Model.Busqueda"
                       asp-route-activo="@Model.Activo"
                       asp-route-page="@p"
                       class="la-btn @(p == Model.Page ? "la-btn-primary" : "la-btn-secondary") la-btn-sm">
                        @p
                    </a>
                }

                <a asp-action="Index"
                   asp-route-busqueda="@Model.Busqueda"
                   asp-route-activo="@Model.Activo"
                   asp-route-page="@(Model.Page + 1)"
                   class="la-btn la-btn-secondary la-btn-sm @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    Siguiente
                </a>
            </nav>
        }
    </div>
}
