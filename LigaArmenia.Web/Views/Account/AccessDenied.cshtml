@{
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
    ViewData["Title"] = "Acceso denegado";
}

<div class="d-flex align-items-center justify-content-center py-5">
    <div class="la-card text-center" style="max-width: 520px; width: 100%;">
        <div class="la-empty-icon mb-3" style="background: var(--la-danger-soft); border-color: rgba(239,68,68,0.4); color: #FCA5A5;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
        </div>
        <span class="la-badge la-badge-danger mb-2">Error 403</span>
        <h1 class="la-page-title mb-2" style="font-size: 1.5rem;">Acceso denegado</h1>
        <p style="color: var(--la-text-secondary); font-size: 0.92rem;" class="mb-4">
            No cuentas con los permisos necesarios para acceder a esta sección o ejecutar esta operación.
            Si consideras que se trata de un error, comunícate con el administrador de la liga.
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Home" asp-action="Index" class="la-btn la-btn-primary">
                    Volver al panel principal
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="la-btn la-btn-primary">
                    Ir al inicio de sesión
                </a>
            }
        </div>
    </div>
</div>
