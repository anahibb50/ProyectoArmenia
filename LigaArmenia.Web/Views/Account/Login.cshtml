@model LigaArmenia.Web.ViewModels.Auth.LoginViewModel
@inject IWebAssetHelper Assets
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Iniciar sesión";
}

<section class="la-auth-container">
    <div class="la-auth-form-panel">
        <div class="la-auth-brand">
            @if (Assets.Exists("images/branding/logo-institucional.png"))
            {
                <img src="@Assets.ResolveUrl("images/branding/logo-institucional.png")"
                     alt="Logotipo Liga Barrial La Armenia"
                     class="la-auth-brand-logo" />
            }
            else
            {
                <span class="la-brand-placeholder" style="width: 52px; height: 52px; font-size: 1rem;" aria-hidden="true">LBLA</span>
            }
            <div>
                <div style="font-size: 1rem; font-weight: 700; color: var(--la-text-primary);">Liga Barrial La Armenia</div>
                <div style="font-size: 0.78rem; color: var(--la-accent-primary); letter-spacing: 0.04em; text-transform: uppercase;">
                    Sistema de Gestión Deportiva
                </div>
            </div>
        </div>

        <h1 class="la-auth-heading">Bienvenido nuevamente</h1>
        <p class="la-auth-subheading">
            Ingresa tus credenciales administrativas para acceder al portal web.
        </p>

        <partial name="Partials/_Alerts" />

        <form asp-controller="Account" asp-action="Login" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Correo" class="la-form-label"></label>
                <input asp-for="Correo"
                       class="la-form-control"
                       type="email"
                       autocomplete="username"
                       placeholder="usuario@ligalaarmenia.org"
                       autofocus />
                <span asp-validation-for="Correo" class="la-validation-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="la-form-label"></label>
                <div class="la-input-group">
                    <input asp-for="Password"
                           id="loginPassword"
                           class="la-form-control"
                           type="password"
                           autocomplete="current-password"
                           placeholder="••••••••" />
                    <button type="button"
                            class="la-password-toggle"
                            data-toggle-password="loginPassword"
                            aria-label="Mostrar u ocultar contraseña"
                            aria-pressed="false">
                        <svg data-eye-open width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg data-eye-closed class="d-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="la-validation-error"></span>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-4">
                <label class="d-inline-flex align-items-center gap-2" style="font-size: 0.86rem; color: var(--la-text-secondary); cursor: pointer;">
                    <input asp-for="Recordarme" style="accent-color: var(--la-accent-primary);" />
                    <span>Mantener sesión iniciada</span>
                </label>
            </div>

            <button type="submit" class="la-btn la-btn-primary w-100 py-2">
                Iniciar sesión
            </button>
        </form>

        <p class="mt-4 mb-0" style="font-size: 0.78rem; color: var(--la-text-muted);">
            Acceso exclusivo para personal autorizado. Los vocales de mesa deben ingresar desde la aplicación móvil oficial.
        </p>
    </div>

    <div class="la-auth-visual-panel">
        <div>
            <span class="la-page-eyebrow">Portal Institucional</span>
            <h2 style="font-size: 1.55rem; font-weight: 700; line-height: 1.25; margin: 0.35rem 0 0.75rem;">
                Control deportivo centralizado, transparente y seguro
            </h2>
            <p style="font-size: 0.9rem; color: var(--la-text-secondary); margin-bottom: 1.5rem;">
                Administra usuarios, roles, campeonatos, comisiones técnicas y disciplinarias bajo un control de acceso basado en permisos.
            </p>
        </div>

        @if (Assets.Exists("images/login/login-hero.jpg"))
        {
            <img src="@Assets.ResolveUrl("images/login/login-hero.jpg")"
                 alt="Liga Barrial La Armenia"
                 class="la-auth-hero-img" />
        }
        else if (Assets.Exists("images/login/login-hero.png"))
        {
            <img src="@Assets.ResolveUrl("images/login/login-hero.png")"
                 alt="Liga Barrial La Armenia"
                 class="la-auth-hero-img" />
        }
        else
        {
            <div class="la-media-placeholder">
                <div class="la-brand-placeholder mb-3" style="width: 56px; height: 56px; font-size: 1.05rem;">LA</div>
                <strong style="color: var(--la-text-primary); font-size: 0.95rem;">Espacio para imagen institucional</strong>
                <span style="font-size: 0.8rem; max-width: 280px; margin-top: 0.35rem;">
                    Agrega tu fotografía deportiva en <code>wwwroot/images/login/login-hero.jpg</code> para mostrarla aquí automáticamente.
                </span>
            </div>
        }

        <div class="la-auth-feature-grid">
            <div class="la-auth-feature-item">
                <strong>Control RBAC</strong>
                <span>Permisos granulares por módulo y acción.</span>
            </div>
            <div class="la-auth-feature-item">
                <strong>Auditoría Activa</strong>
                <span>Trazabilidad de creación y cambios de cuentas.</span>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
