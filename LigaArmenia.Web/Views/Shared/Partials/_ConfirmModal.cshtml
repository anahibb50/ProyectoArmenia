<div class="modal fade la-modal" id="laConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" data-confirm-modal-title>Confirmar operación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0" style="color: var(--la-text-secondary);" data-confirm-modal-message>
                    ¿Deseas continuar con esta acción?
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="la-btn la-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="la-btn la-btn-primary" data-confirm-modal-accept>Confirmar</button>
            </div>
        </div>
    </div>
</div>
