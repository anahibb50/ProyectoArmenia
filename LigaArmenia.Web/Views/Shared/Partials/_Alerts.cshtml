@if (TempData["SuccessMessage"] is string success && !string.IsNullOrWhiteSpace(success))
{
    <div class="la-alert la-alert-success alert-dismissible fade show" role="alert">
        <div>@success</div>
        <button type="button" class="la-alert-close" data-bs-dismiss="alert" aria-label="Cerrar">&times;</button>
    </div>
}

@if (TempData["WarningMessage"] is string warning && !string.IsNullOrWhiteSpace(warning))
{
    <div class="la-alert la-alert-warning alert-dismissible fade show" role="alert">
        <div>@warning</div>
        <button type="button" class="la-alert-close" data-bs-dismiss="alert" aria-label="Cerrar">&times;</button>
    </div>
}

@if (TempData["ErrorMessage"] is string error && !string.IsNullOrWhiteSpace(error))
{
    <div class="la-alert la-alert-danger alert-dismissible fade show" role="alert">
        <div>@error</div>
        <button type="button" class="la-alert-close" data-bs-dismiss="alert" aria-label="Cerrar">&times;</button>
    </div>
}

@if (TempData["InfoMessage"] is string info && !string.IsNullOrWhiteSpace(info))
{
    <div class="la-alert la-alert-info alert-dismissible fade show" role="alert">
        <div>@info</div>
        <button type="button" class="la-alert-close" data-bs-dismiss="alert" aria-label="Cerrar">&times;</button>
    </div>
}
