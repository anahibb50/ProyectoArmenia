@model ErrorViewModel
@{
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
    ViewData["Title"] = "Error inesperado";
}

<div class="d-flex align-items-center justify-content-center py-5">
    <div class="la-card text-center" style="max-width: 520px; width: 100%;">
        <span class="la-badge la-badge-danger mb-2">Error</span>
        <h1 class="la-page-title mb-2" style="font-size: 1.5rem;">Ocurrió un error al procesar la solicitud</h1>
        <p style="color: var(--la-text-secondary); font-size: 0.9rem;" class="mb-3">
            Intenta nuevamente o comunícate con el administrador si el problema persiste.
        </p>
        @if (Model.ShowRequestId)
        {
            <p style="font-size: 0.8rem; color: var(--la-text-muted);" class="mb-4">
                Código de referencia: <code>@Model.RequestId</code>
            </p>
        }
        <a asp-controller="Home" asp-action="Index" class="la-btn la-btn-primary">Volver al inicio</a>
    </div>
</div>
